<?xml version="1.0" encoding="utf-8"?>
<!-- WARPSCOUT GUI — Android-оболочка (WebView + ядро warpscout).
     Обновление поверх: тот же package + тот же ключ подписи (keystore
     desktop-app/android/keystore/) — новая версия ставится как апдейт. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.warpscout.gui"
    android:versionCode="20604"
    android:versionName="2.6.4">

    <!-- Сеть: регистрация аккаунта в Cloudflare и сканирование (ядро warpscout) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v2.6.0 (аудит SEC-6): ЕДИНСТВЕННОЕ разрешение приложения. Хранилище:
         данные — в app-specific каталоге (разрешений не требует), публичная
         выгрузка (конфиги/копии отчётов и аккаунта) — в
         Download/WARPScoutGUI через MediaStore.Downloads (API 29+, без
         разрешений). Разрешения WRITE_EXTERNAL_STORAGE и
         MANAGE_EXTERNAL_STORAGE («Все файлы») удалены вместе с механикой
         «В общую папку» v2.5.3–2.5.8: выбор папки данных и перенос в общий
         том больше не существуют. -->

    <!-- v2.5.9 (аудит SEC-2): приложение хранит приватные ключи WARP
         (warpscout-account.json) и .storage — автобэкапы в облако
         и adb backup отключены полностью. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|locale|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Свой мини-FileProvider (без androidx): content://ru.warpscout.gui.files/root/<абсолютный путь> -->
        <provider
            android:name=".WsFileProvider"
            android:authorities="ru.warpscout.gui.files"
            android:grantUriPermissions="true"
            android:exported="false" />
    </application>
</manifest>
